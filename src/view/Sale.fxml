<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="560.0" minWidth="760.0" styleClass="sale-page" stylesheets="@../resources/css/SoleManager.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.SaleController">
   <center>
      <VBox spacing="12.0" styleClass="sale-product-area" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Button fx:id="btnAll" mnemonicParsing="false" onAction="#filterCategory" styleClass="sale-chip, sale-chip-active" text="Tất cả" />
                  <Button fx:id="btnRunning" mnemonicParsing="false" onAction="#filterCategory" styleClass="sale-chip" text="Chạy bộ" />
                  <Button fx:id="btnBasketball" mnemonicParsing="false" onAction="#filterCategory" styleClass="sale-chip" text="Bóng rổ" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="lblProductCount" styleClass="sale-count" text="Hiển thị 24 sản phẩm" />
               </children>
            </HBox>

            <TableView fx:id="tblProducts" styleClass="sale-table" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colImage" minWidth="68.0" prefWidth="78.0" text="Hình ảnh" />
                  <TableColumn fx:id="colProduct" minWidth="170.0" prefWidth="205.0" text="Sản phẩm" />
                  <TableColumn fx:id="colSku" minWidth="86.0" prefWidth="96.0" text="SKU" />
                  <TableColumn fx:id="colBrand" minWidth="94.0" prefWidth="104.0" text="Thương hiệu" />
                  <TableColumn fx:id="colSize" minWidth="82.0" prefWidth="92.0" text="Size" />
                  <TableColumn fx:id="colColor" minWidth="92.0" prefWidth="104.0" text="Màu sắc" />
                  <TableColumn fx:id="colStock" minWidth="70.0" prefWidth="78.0" text="Tồn kho" />
                  <TableColumn fx:id="colPrice" minWidth="110.0" prefWidth="124.0" text="Giá bán" />
                  <TableColumn fx:id="colAction" minWidth="58.0" prefWidth="66.0" text="" />
               </columns>
            </TableView>
         </children>
         <padding>
            <Insets bottom="0.0" left="0.0" right="14.0" top="0.0" />
         </padding>
      </VBox>
   </center>

   <right>
      <VBox prefWidth="300.0" spacing="0.0" styleClass="cart-panel" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="cart-header">
               <children>
                  <Label styleClass="cart-title-icon" text="□" />
                  <Label styleClass="cart-title" text="ĐƠN HÀNG HIỆN TẠI" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#clearCart" styleClass="clear-cart" text="Xóa hết" />
               </children>
            </HBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="cart-scroll" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="cartItemsBox" spacing="12.0" styleClass="cart-items-box" />
               </content>
            </ScrollPane>

            <VBox spacing="10.0" styleClass="cart-summary">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label styleClass="summary-label" text="Tạm tính" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblSubtotal" styleClass="summary-value" text="0đ" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label styleClass="summary-label" text="Chiết khấu (5%)" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblDiscount" styleClass="summary-discount" text="0đ" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" styleClass="summary-total-row">
                     <children>
                        <Label styleClass="total-label" text="TỔNG CỘNG" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblTotal" styleClass="total-value" text="0đ" />
                     </children>
                  </HBox>

                  <Label styleClass="payment-title" text="PHƯƠNG THỨC THANH TOÁN" />
                  <HBox spacing="8.0">
                     <children>
                        <Button fx:id="btnCash" mnemonicParsing="false" onAction="#selectPayment" styleClass="payment-card, payment-card-active" text="▣&#10;Tiền mặt" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnBank" mnemonicParsing="false" onAction="#selectPayment" styleClass="payment-card" text="⌂&#10;Chuyển khoản" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnCard" mnemonicParsing="false" onAction="#selectPayment" styleClass="payment-card" text="▤&#10;Thẻ Visa/MC" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>

                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#checkout" styleClass="checkout-button" text="▣  THANH TOÁN &amp; IN HÓA ĐƠN" />
               </children>
            </VBox>
         </children>
      </VBox>
   </right>

   <bottom>
      <HBox alignment="CENTER_RIGHT" mouseTransparent="true" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" styleClass="floating-action" text="☷" />
         </children>
         <padding>
            <Insets bottom="8.0" right="16.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
