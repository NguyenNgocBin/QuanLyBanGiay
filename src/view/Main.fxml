<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane minHeight="640.0" minWidth="980.0" prefHeight="720.0" prefWidth="1080.0" stylesheets="@../resources/css/SoleManager.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MainController">
   <left>
      <VBox prefHeight="720.0" prefWidth="170.0" style="-fx-background-color: #004395;" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="sidebar-title" text="DUCBINZ" />
            <Label styleClass="sidebar-subtitle" text="Hệ thống quản lý giày" textFill="WHITE" />

            <Button fx:id="btnDashboard" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#switchTab" styleClass="nav-button, nav-button-active" text="  Tổng quan" />
            <Button fx:id="btnProducts" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#switchTab" styleClass="nav-button" text=" Kho hàng" />
            <Button fx:id="btnCategories" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#switchTab" styleClass="nav-button" text="Danh mục" />
            <Button fx:id="btnSuppliers" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#switchTab" styleClass="nav-button" text="Nhà cung cấp" />
            <Button fx:id="btnStaff" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#switchTab" styleClass="nav-button" text="Nhân viên" />
            <Button fx:id="btnImportHistory" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#switchTab" styleClass="nav-button" text="Lịch sử nhập" />
            <Button fx:id="btnSales" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#switchTab" styleClass="nav-button" text="Bán hàng" />
            <Button fx:id="btnOrders" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#switchTab" styleClass="nav-button" text="Đơn hàng" />
            <Button fx:id="btnReports" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#switchTab" styleClass="nav-button" text="Báo cáo" />

            <VBox VBox.vgrow="ALWAYS" />

            <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-button" text="⚙  Cài đặt" />
            <Button fx:id="btnLogout" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLogout" styleClass="nav-button" text="↩  Đăng xuất" />
         </children>
      </VBox>
   </left>
   <center>
      <VBox prefHeight="720.0" prefWidth="100.0" styleClass="main-content-shell" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="48.0" styleClass="app-topbar">
               <children>
                  <HBox prefHeight="19.0" prefWidth="730.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label prefHeight="47.0" prefWidth="415.0" text="&quot;Bán hàng siêu tốc, quản lý siêu nhàn&quot;">
                           <font>
                              <Font name="System Italic" size="15.0" />
                           </font>
                        </Label>
                     </children></HBox>
                  <Label styleClass="topbar-bell" text="!" />
                  <VBox alignment="CENTER_RIGHT">
                     <children>
                        <Label fx:id="lblUsername" styleClass="topbar-user-name" text="Nguyễn Văn A" />
                        <Label fx:id="lblRole" styleClass="topbar-user-role" text="Nhân viên bán hàng" />
                     </children>
                  </VBox>
                  <Label styleClass="topbar-avatar" text="◎" />
               </children>
               <padding>
                  <Insets left="18.0" right="14.0" />
               </padding>
            </HBox>

            <StackPane fx:id="contentPane" prefHeight="672.0" prefWidth="858.0" VBox.vgrow="ALWAYS" />
         </children>
      </VBox>
   </center>
</BorderPane>
