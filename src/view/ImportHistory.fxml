<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="560.0" minWidth="720.0" spacing="16.0" styleClass="warehouse-page" stylesheets="@../resources/css/SoleManager.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ImportHistoryController">
   <children>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="warehouse-scroll" VBox.vgrow="ALWAYS">
         <content>
            <VBox spacing="16.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="16.0">
                     <children>
                        <VBox spacing="4.0">
                           <children>
                              <Label styleClass="page-title" text="Lịch sử Nhập kho" />
                              <HBox spacing="6.0">
                                 <children>
                                    <Label styleClass="breadcrumb-muted" text="Trang chủ" />
                                    <Label styleClass="breadcrumb-muted" text="/" />
                                    <Label styleClass="breadcrumb-active" text="Lịch sử nhập kho" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>

                  <VBox spacing="0.0" styleClass="warehouse-panel" VBox.vgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="filter-row">
                           <children>
                              <TextField fx:id="txtSearch" maxWidth="360.0" prefHeight="38.0" prefWidth="320.0" promptText="Tìm theo mã phiếu, tên NCC..." styleClass="warehouse-search" HBox.hgrow="ALWAYS" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Label fx:id="lblShowing" styleClass="result-count" text="Hiển thị 0 phiếu nhập" />
                           </children>
                        </HBox>

                        <TableView fx:id="historyTable" prefHeight="500.0" prefWidth="1085.0" styleClass="warehouse-table" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colId" minWidth="80.0" prefWidth="100.0" text="MÃ PHIẾU" />
                              <TableColumn fx:id="colSupplierName" minWidth="180.0" prefWidth="240.0" text="NHÀ CUNG CẤP" />
                              <TableColumn fx:id="colImportDate" minWidth="120.0" prefWidth="150.0" text="NGÀY NHẬP" />
                              <TableColumn fx:id="colTotalAmount" minWidth="130.0" prefWidth="160.0" text="TỔNG TIỀN" />
                              <TableColumn fx:id="colTotalItems" minWidth="100.0" prefWidth="120.0" text="SỐ LƯỢNG SP" />
                              <TableColumn fx:id="colStatus" minWidth="110.0" prefWidth="130.0" text="TRẠNG THÁI" />
                              <TableColumn fx:id="colAction" minWidth="120.0" prefWidth="140.0" text="HÀNH ĐỘNG" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</VBox>
