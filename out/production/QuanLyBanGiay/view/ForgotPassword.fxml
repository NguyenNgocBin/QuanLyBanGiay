<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-image: url('/resources/img/unnamed.png'); -fx-background-size: cover; -fx-background-position: center;" stylesheets="@../resources/css/Style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ForgotPasswordController">

    <!-- Center Card -->
    <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="450" spacing="20" style="-fx-background-color: rgba(255, 255, 255, 0.93); -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0, 0, 5);">
        <padding>
            <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
        </padding>

        <!-- BƯỚC 1: NHẬP EMAIL -->
        <VBox fx:id="step1Box" alignment="CENTER" spacing="15" visible="true" managed="true">
            <VBox alignment="CENTER" spacing="5">
                <Label style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-text-fill: #111;" text="QUÊN MẬT KHẨU" />
                <Label style="-fx-text-fill: #666; -fx-font-size: 14px;" text="Nhập email để nhận mã xác minh." />
            </VBox>
            
            <VBox spacing="5" maxWidth="Infinity">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #555; -fx-font-size: 11px;" text="EMAIL" />
                <TextField fx:id="txtEmail" promptText="VD: abc@gmail.com" style="-fx-pref-height: 45; -fx-background-radius: 5; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-color: white; -fx-font-size: 14px;" />
            </VBox>

            <Button fx:id="btnSendCode" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSendCode" style="-fx-background-color: #ff4500; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-pref-height: 45; -fx-background-radius: 5; -fx-cursor: hand;" text="GỬI MÃ XÁC NHẬN" />
            
            <Label onMouseClicked="#backToLogin" style="-fx-text-fill: #666; -fx-font-size: 13px; -fx-cursor: hand; -fx-underline: true;" text="Quay lại đăng nhập" />
        </VBox>

        <!-- BƯỚC 2: NHẬP MÃ XÁC NHẬN -->
        <VBox fx:id="step2Box" alignment="CENTER" spacing="15" visible="false" managed="false">
            <VBox alignment="CENTER" spacing="5">
                <Label style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-text-fill: #111;" text="XÁC NHẬN MÃ" />
                <Label style="-fx-text-fill: #666; -fx-font-size: 14px;" text="Nhập mã 6 số được gửi đến email của bạn." />
            </VBox>
            
            <VBox spacing="5" maxWidth="Infinity">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #555; -fx-font-size: 11px;" text="MÃ XÁC NHẬN" />
                <TextField fx:id="txtCode" promptText="X X X X X X" style="-fx-pref-height: 45; -fx-background-radius: 5; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-color: white; -fx-font-size: 14px; -fx-alignment: center; -fx-font-weight: bold; -fx-letter-spacing: 5px;" />
            </VBox>

            <Button fx:id="btnVerifyCode" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleVerifyCode" style="-fx-background-color: #ff4500; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-pref-height: 45; -fx-background-radius: 5; -fx-cursor: hand;" text="XÁC NHẬN MÃ" />
            
            <Label onMouseClicked="#backToStep1" style="-fx-text-fill: #666; -fx-font-size: 13px; -fx-cursor: hand; -fx-underline: true;" text="Quay lại nhập Email" />
        </VBox>

        <!-- BƯỚC 3: ĐỔI MẬT KHẨU -->
        <VBox fx:id="step3Box" alignment="CENTER" spacing="15" visible="false" managed="false">
            <VBox alignment="CENTER" spacing="5">
                <Label style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-text-fill: #111;" text="ĐỔI MẬT KHẨU" />
                <Label style="-fx-text-fill: #666; -fx-font-size: 14px;" text="Tạo mật khẩu mới cho tài khoản của bạn." />
            </VBox>
            
            <VBox spacing="5" maxWidth="Infinity">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #555; -fx-font-size: 11px;" text="MẬT KHẨU MỚI" />
                <PasswordField fx:id="txtNewPassword" promptText="••••••" style="-fx-pref-height: 45; -fx-background-radius: 5; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-color: white; -fx-font-size: 14px;" />
            </VBox>

            <VBox spacing="5" maxWidth="Infinity">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #555; -fx-font-size: 11px;" text="NHẬP LẠI MẬT KHẨU" />
                <PasswordField fx:id="txtConfirmPassword" promptText="••••••" style="-fx-pref-height: 45; -fx-background-radius: 5; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-color: white; -fx-font-size: 14px;" />
            </VBox>

            <Button fx:id="btnResetPassword" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleResetPassword" style="-fx-background-color: #ff4500; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-pref-height: 45; -fx-background-radius: 5; -fx-cursor: hand;" text="LƯU MẬT KHẨU" />
        </VBox>

        <!-- THÔNG BÁO LỖI CHUNG -->
        <Text fx:id="txtMessage" fill="RED" />
    </VBox>
</StackPane>
