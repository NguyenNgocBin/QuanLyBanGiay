<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="640.0" minWidth="980.0" prefHeight="720.0" prefWidth="1080.0" stylesheets="@../resources/css/SoleManager.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MainController">
   <left>
      <VBox prefHeight="720.0" prefWidth="170.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="sidebar-title" text="SoleManager" />
            <Label styleClass="sidebar-subtitle" text="Hệ thống quản lý giày" />

            <Button fx:id="btnDashboard" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#switchTab" styleClass="nav-button, nav-button-active" text="▦  Tổng quan" />
            <Button fx:id="btnProducts" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#switchTab" styleClass="nav-button" text="□  Kho hàng" />
            <Button fx:id="btnSales" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#switchTab" styleClass="nav-button" text="▣  Bán hàng" />
            <Button fx:id="btnOrders" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#switchTab" styleClass="nav-button" text="▤  Đơn hàng" />
            <Button fx:id="btnReports" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#switchTab" styleClass="nav-button" text="▥  Báo cáo" />

            <VBox VBox.vgrow="ALWAYS" />

            <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-button" text="⚙  Cài đặt" />
            <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-button" text="↩  Đăng xuất" />
         </children>
      </VBox>
   </left>
   <center>
      <VBox prefHeight="720.0" prefWidth="100.0" styleClass="main-content-shell" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="48.0" styleClass="app-topbar">
               <children>
                  <TextField promptText="Tìm kiếm sản phẩm, mã SKU hoặc tên giày..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                  <HBox HBox.hgrow="ALWAYS" />
                  <Label styleClass="topbar-bell" text="!" />
                  <VBox alignment="CENTER_RIGHT">
                     <children>
                        <Label styleClass="topbar-user-name" text="Nguyễn Văn A" />
                        <Label styleClass="topbar-user-role" text="Nhân viên bán hàng" />
                     </children>
                  </VBox>
                  <Label styleClass="topbar-avatar" text="◎" />
               </children>
               <padding>
                  <Insets left="18.0" right="14.0" />
               </padding>
            </HBox>

            <StackPane fx:id="contentPane" VBox.vgrow="ALWAYS" />
         </children>
      </VBox>
   </center>
</BorderPane>
