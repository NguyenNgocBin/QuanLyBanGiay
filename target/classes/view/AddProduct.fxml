<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="640.0" prefWidth="373.0" spacing="18.0" styleClass="product-form" stylesheets="@../resources/css/SoleManager.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AddProductController">
   <padding>
      <Insets bottom="22.0" left="24.0" right="24.0" top="22.0" />
   </padding>
   <children>
      <Label styleClass="form-title" text="Thêm sản phẩm mới" />

      <GridPane hgap="16.0" vgap="12.0">
         <children>
            <VBox spacing="5.0">
               <children>
                  <Label styleClass="form-label" text="Tên sản phẩm" />
                  <TextField fx:id="txtName" promptText="Nhập tên giày..." styleClass="form-input" />
               </children>
            </VBox>

            <VBox spacing="5.0" GridPane.columnIndex="1">
               <children>
                  <Label styleClass="form-label" text="Mã SKU" />
                  <TextField fx:id="txtProductCode" promptText="#SH-1234" styleClass="form-input" />
               </children>
            </VBox>

            <VBox spacing="5.0" GridPane.rowIndex="1">
               <children>
                  <Label styleClass="form-label" text="Danh mục / thương hiệu" />
                  <ComboBox fx:id="cbCategory" maxWidth="1.7976931348623157E308" promptText="Chọn danh mục" styleClass="form-input" />
               </children>
            </VBox>

            <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
               <children>
                  <Label styleClass="form-label" text="Giá bán" />
                  <TextField fx:id="txtPrice" promptText="0" styleClass="form-input" />
               </children>
            </VBox>

            <VBox spacing="5.0" GridPane.rowIndex="2">
               <children>
                  <Label styleClass="form-label" text="Size" />
                  <TextField fx:id="txtSize" promptText="39, 40, 41" styleClass="form-input" />
               </children>
            </VBox>

            <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
               <children>
                  <Label styleClass="form-label" text="Tồn kho" />
                  <TextField fx:id="txtStock" promptText="0" styleClass="form-input" />
               </children>
            </VBox>

            <VBox spacing="5.0" GridPane.rowIndex="3">
               <children>
                  <Label styleClass="form-label" text="Nhà cung cấp" />
                  <ComboBox fx:id="cbSupplier" maxWidth="1.7976931348623157E308" promptText="Chọn nhà cung cấp" styleClass="form-input" />
               </children>
            </VBox>

            <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
               <children>
                  <Label styleClass="form-label" text="Giá nhập" />
                  <TextField fx:id="txtImportPrice" promptText="0" styleClass="form-input" />
               </children>
            </VBox>

            <VBox spacing="5.0" GridPane.columnSpan="2" GridPane.rowIndex="4">
               <children>
                  <Label styleClass="form-label" text="Tổng tiền nhập hàng" />
                  <Label fx:id="lblTotalAmount" style="-fx-text-fill: #10B981; -fx-font-weight: bold; -fx-font-size: 16px;" text="0đ" />
               </children>
            </VBox>

            <VBox spacing="8.0" GridPane.columnSpan="2" GridPane.rowIndex="5">
               <children>
                  <Label styleClass="form-label" text="Hình ảnh sản phẩm" />
                  <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="image-picker">
                     <children>
                        <StackPane styleClass="image-preview">
                           <children>
                              <ImageView fx:id="imgPreview" fitHeight="74.0" fitWidth="90.0" pickOnBounds="true" preserveRatio="true" />
                              <Label styleClass="image-placeholder" text="No Image" />
                           </children>
                        </StackPane>
                        <VBox alignment="CENTER_LEFT" spacing="6.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#chooseImage" styleClass="form-secondary" text="Chọn ảnh" />
                              <Label styleClass="form-hint" text="Hỗ trợ JPG, PNG" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
      </GridPane>

      <Label fx:id="lblMessage" styleClass="form-error" />

      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#cancel" styleClass="form-secondary" text="Hủy bỏ" />
            <Button mnemonicParsing="false" onAction="#save" styleClass="form-primary" text="Lưu sản phẩm" />
         </children>
      </HBox>
   </children>
</VBox>
