<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
    minWidth="-Infinity" prefHeight="550.0" prefWidth="600.0" spacing="20.0"
    style="-fx-background-color: white; -fx-border-color: #dcdcdc; -fx-border-width: 1;"
    xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controller.EditProductController">

    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <children>
        <Label text="CHỈNH SỬA SẢN PHẨM" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
            <VBox.margin>
                <Insets bottom="10.0" />
            </VBox.margin>
        </Label>

        <GridPane hgap="15.0" vgap="20.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="130.0"
                    prefWidth="130.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="250.0" />
            </columnConstraints>

            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
            </rowConstraints>

            <children>
                <Label text="Mã ID:" textFill="#555555">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="txtId" disable="true" editable="false" prefHeight="40.0"
                    style="-fx-background-color: #f0f0f0; -fx-border-color: #dcdcdc; -fx-border-radius: 4;"
                    text="#SH-1102" GridPane.columnIndex="1" />

                <Label text="Tên sản phẩm:" textFill="#555555" GridPane.rowIndex="1">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="txtName" prefHeight="40.0" promptText="Nhập tên giày..."
                    style="-fx-border-color: #ced4da; -fx-border-radius: 4; -fx-background-radius: 4;"
                    GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Danh mục:" textFill="#555555" GridPane.rowIndex="2">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <ComboBox fx:id="cbCategory" maxWidth="1.7976931348623157E308" prefHeight="40.0"
                    style="-fx-background-color: white; -fx-border-color: #ced4da; -fx-border-radius: 4;"
                    GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Sneaker" />
                            <String fx:value="Giày da" />
                            <String fx:value="Running" />
                            <String fx:value="Boots" />
                        </FXCollections>
                    </items>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </ComboBox>

                <Label text="Giá bán (VNĐ):" textFill="#555555" GridPane.rowIndex="3">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="txtPrice" prefHeight="40.0" promptText="VD: 2500000"
                    style="-fx-border-color: #ced4da; -fx-border-radius: 4; -fx-background-radius: 4;"
                    GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Size:" textFill="#555555" GridPane.rowIndex="4">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="txtSize" prefHeight="40.0" promptText="VD: 38-42"
                    style="-fx-border-color: #ced4da; -fx-border-radius: 4; -fx-background-radius: 4;"
                    GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <Label text="Tồn kho:" textFill="#555555" GridPane.rowIndex="5">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="txtStock" prefHeight="40.0" promptText="Số lượng..."
                    style="-fx-border-color: #ced4da; -fx-border-radius: 4; -fx-background-radius: 4;"
                    GridPane.columnIndex="1" GridPane.rowIndex="5" />
            </children>
        </GridPane>

        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <children>
                <Button mnemonicParsing="false" onAction="#buttonCancel" prefHeight="40.0"
                    prefWidth="120.0"
                    style="-fx-background-color: #e2e6ea; -fx-text-fill: #495057; -fx-font-weight: bold; -fx-cursor: hand;"
                    text="Hủy bỏ">
                    <font>
                        <Font size="14.0" />
                    </font>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
                <Button mnemonicParsing="false" onAction="#buttonSave" prefHeight="40.0"
                    prefWidth="140.0"
                    style="-fx-background-color: #4080ff; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                    text="Lưu thay đổi">
                    <font>
                        <Font size="14.0" />
                    </font>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
            </children>
            <VBox.margin>
                <Insets top="20.0" />
            </VBox.margin>
        </HBox>

    </children>
</VBox>