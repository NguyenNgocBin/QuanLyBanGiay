<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="250.0"
    prefHeight="700.0" prefWidth="1200.0" style="-fx-background-color: #F5F5F5;"
    stylesheets="@../resources/css/Style.css" xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ProductController">

    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <VBox spacing="20.0" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                    </padding>
                    <children>

                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Quản lý sản phẩm" textFill="#111827">
                                            <font>
                                                <Font name="System Bold" size="28.0" />
                                            </font>
                                        </Label>
                                        <Label
                                            text="Quản lý kho hàng, thông tin giày và cập nhật giá cả."
                                            textFill="#6b7280">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />

                                <Button mnemonicParsing="false" onAction="#themMoiProduct"
                                    styleClass="buttonAdd" text="+ Thêm sản phẩm mới" />

                            </children>
                        </HBox>

                        <VBox
                            style="-fx-background-color: #FFFFFF; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 0);"
                            VBox.vgrow="ALWAYS">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>

                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <TextField fx:id="txtSearch" prefWidth="300.0"
                                            promptText="Tìm kiếm theo tên giày, mã ID..."
                                            style="-fx-background-color: #FFFFFF; -fx-border-color: #D1D5DB; -fx-border-radius: 5; -fx-text-fill: #111827;">
                                            <padding>
                                                <Insets bottom="10.0" left="10.0" right="10.0"
                                                    top="10.0" />
                                            </padding>
                                            <cursor>
                                                <Cursor fx:constant="HAND" />
                                            </cursor>
                                        </TextField>

                                        <ComboBox fx:id="cbxDanhMuc" promptText="Tất cả danh mục"
                                            style="-fx-background-color: #FFFFFF; -fx-border-color: #D1D5DB; -fx-border-radius: 5; -fx-text-fill: black;" />

                                        <Region HBox.hgrow="ALWAYS" />

                                        <Button mnemonicParsing="false"
                                            style="-fx-background-color: transparent; -fx-border-color: #D1D5DB; -fx-border-radius: 5; -fx-cursor: hand;"
                                            text="⬇ Xuất Excel" textFill="#374151">
                                            <padding>
                                                <Insets bottom="8.0" left="15.0" right="15.0"
                                                    top="8.0" />
                                            </padding>
                                        </Button>
                                    </children>
                                    <VBox.margin>
                                        <Insets bottom="20.0" />
                                    </VBox.margin>
                                </HBox>

                                <TableView fx:id="tableProducts"
                                    style="-fx-background-color: transparent; -fx-base: #FFFFFF; -fx-control-inner-background: #FFFFFF; -fx-table-cell-border-color: #E5E7EB;"
                                    VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colId" prefWidth="100.0" text="ID" />
                                        <TableColumn fx:id="colProduct" prefWidth="300.0"
                                            text="SẢN PHẨM" />
                                        <TableColumn fx:id="colCategory" prefWidth="150.0"
                                            text="DANH MỤC" />
                                        <TableColumn fx:id="colPrice" prefWidth="150.0"
                                            text="GIÁ BÁN" />
                                        <TableColumn fx:id="colSize" prefWidth="100.0"
                                            style="-fx-alignment: CENTER;" text="SIZE " />
                                        <TableColumn fx:id="colStock" prefWidth="100.0"
                                            style="-fx-alignment: CENTER;" text="TỒN KHO" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>

                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <HBox spacing="5.0" />
                                    </children>
                                    <VBox.margin>
                                        <Insets top="15.0" />
                                    </VBox.margin>
                                </HBox>

                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>